          "z": 400.0
        }
      },
      "attributes": {
        "world": "sim-world",
        "color": [
          0.7,
          0.7,
          0.8
        ]
      }
    },
    {
      "name": "wall-e",
      "api": "rdk:component:generic",
      "model": "viam-labs:mujoco-sim:obstacle",
      "frame": {
        "parent": "world",
        "translation": {
          "x": 1500.0,
          "y": 0,
          "z": 200.0
        },
        "geometry": {
          "type": "box",
          "x": 40.0,
          "y": 3040.0,
          "z": 400.0
        }
      },
      "attributes": {
        "world": "sim-world",
        "color": [
          0.8,
          0.7,
          0.7
        ]
      }
    },
    {
      "name": "wall-w",
      "api": "rdk:component:generic",
      "model": "viam-labs:mujoco-sim:obstacle",
      "frame": {
        "parent": "world",
        "translation": {
          "x": -1500.0,
          "y": 0,
          "z": 200.0
        },
        "geometry": {
          "type": "box",
          "x": 40.0,
          "y": 3040.0,
          "z": 400.0
        }
      },
      "attributes": {
        "world": "sim-world",
        "color": [
          0.7,
          0.8,
          0.7
        ]
      }
    },
    {
      "name": "box-a",
      "api": "rdk:component:generic",
      "model": "viam-labs:mujoco-sim:obstacle",
      "frame": {
        "parent": "world",
        "translation": {
          "x": 600.0,
          "y": 700.0,
          "z": 200.0
        },
        "geometry": {
          "type": "box",
          "x": 300.0,
          "y": 300.0,
          "z": 400.0
        }
      },
      "attributes": {
        "world": "sim-world",
        "color": [
          0.9,
          0.3,
          0.2
        ]
      }
    },
    {
      "name": "box-b",
      "api": "rdk:component:generic",
      "model": "viam-labs:mujoco-sim:obstacle",
      "frame": {
        "parent": "world",
        "translation": {
          "x": -800.0,
          "y": -400.0,
          "z": 200.0
        },
        "geometry": {
          "type": "box",
          "x": 200.0,
          "y": 500.0,
          "z": 400.0
        }
      },
      "attributes": {
        "world": "sim-world",
        "color": [
          0.2,
          0.4,
          0.9
        ]
      }
    },
    {
      "name": "rover",
      "api": "rdk:component:base",
      "model": "viam-labs:mujoco-sim:base",
      "frame": {
        "parent": "world"
      },
      "attributes": {
        "world": "sim-world",
        "asset": "viam_rover"
      }
    },
    {
      "name": "lidar",
      "api": "rdk:component:camera",
      "model": "viam-labs:mujoco-sim:lidar",
      "frame": {
        "parent": "rover",
        "translation": {
          "x": 0,
          "y": 0,
          "z": 160
        }
      },
      "attributes": {
        "world": "sim-world"
      }
    },
    {
      "name": "odometry",
      "api": "rdk:component:movement_sensor",
      "model": "viam-labs:mujoco-sim:movement_sensor",
      "attributes": {
        "world": "sim-world",
        "base": "rover",
        "linear_scale_error": 0.02,
        "heading_drift_dps": 0.05
      }
    },
    {
      "name": "nav-view",
      "api": "rdk:component:camera",
      "model": "viam-labs:nav-stack:nav-camera",
      "attributes": {
        "navigation": "nav"
      }
    }
  ],
  "services": [
    {
      "name": "slam",
      "api": "rdk:service:slam",
      "model": "viam-labs:nav-stack:slam",
      "attributes": {
        "base": "rover",
        "movement_sensor": "odometry",
        "lidar": "lidar",
        "movement_sensor_yaw_deg": 0,
        "mode": "mapping",
        "maps_dir": "/tmp/nav-maps",
        "active_map": "rover-pen"
      }
    },
    {
      "name": "nav",
      "api": "rdk:service:navigation",
      "model": "viam-labs:nav-stack:navigation",
      "attributes": {
        "slam_service": "slam",
        "base": "rover"
      }
    }
  ]
}
