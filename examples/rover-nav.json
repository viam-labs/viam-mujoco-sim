{
  "modules": [
    {
      "type": "local",
      "name": "mujoco-sim",
      "executable_path": "/ABSOLUTE/PATH/TO/viam-mujoco-sim/run.sh"
    },
    {
      "type": "registry",
      "name": "viam-labs_nav-stack",
      "module_id": "viam-labs:nav-stack",
      "version": "latest"
    }
  ],
  "components": [
    {
      "name": "sim-world",
      "api": "rdk:component:generic",
      "model": "viam-labs:mujoco-sim:world",
      "attributes": {
        "props": [
          {
            "name": "wall_n",
            "type": "cube",
            "fixed": true,
            "size": 1,
            "scale": [
              3,
              0.04,
              0.4
            ],
            "position": [
              0,
              1.5,
              0.2
            ],
            "color": [
              0.8,
              0.8,
              0.8
            ]
          },
          {
            "name": "wall_s",
            "type": "cube",
            "fixed": true,
            "size": 1,
            "scale": [
              3,
              0.04,
              0.4
            ],
            "position": [
              0,
              -1.5,
              0.2
            ],
            "color": [
              0.7,
              0.7,
              0.8
            ]
          },
          {
            "name": "wall_e",
            "type": "cube",
            "fixed": true,
            "size": 1,
            "scale": [
              0.04,
              3.04,
              0.4
            ],
            "position": [
              1.5,
              0,
              0.2
            ],
            "color": [
              0.8,
              0.7,
              0.7
            ]
          },
          {
            "name": "wall_w",
            "type": "cube",
            "fixed": true,
            "size": 1,
            "scale": [
              0.04,
              3.04,
              0.4
            ],
            "position": [
              -1.5,
              0,
              0.2
            ],
            "color": [
              0.7,
              0.8,
              0.7
            ]
          },
          {
            "name": "box_a",
            "type": "cube",
            "fixed": true,
            "size": 1,
            "scale": [
              0.3,
              0.3,
              0.4
            ],
            "position": [
              0.6,
              0.7,
              0.2
            ],
            "color": [
              0.9,
              0.3,
              0.2
            ]
          },
          {
            "name": "box_b",
            "type": "cube",
            "fixed": true,
            "size": 1,
            "scale": [
              0.2,
              0.5,
              0.4
            ],
            "position": [
              -0.8,
              -0.4,
              0.2
            ],
            "color": [
              0.2,
              0.4,
              0.9
            ]
          }
        ]
      }
    },
    {
      "name": "rover",
      "api": "rdk:component:base",
      "model": "viam-labs:mujoco-sim:base",
      "frame": {
        "parent": "world"
      },
      "attributes": {
        "world": "sim-world",
        "asset": "viam_rover"
      }
    },
    {
      "name": "lidar",
      "api": "rdk:component:camera",
      "model": "viam-labs:mujoco-sim:lidar",
      "frame": {
        "parent": "rover",
        "translation": {
          "x": 0,
          "y": 0,
          "z": 160
        }
      },
      "attributes": {
        "world": "sim-world"
      }
    },
    {
      "name": "odometry",
      "api": "rdk:component:movement_sensor",
      "model": "viam-labs:mujoco-sim:movement_sensor",
      "attributes": {
        "world": "sim-world",
        "base": "rover",
        "linear_scale_error": 0.02,
        "heading_drift_dps": 0.05
      }
    },
    {
      "name": "nav-view",
      "api": "rdk:component:camera",
      "model": "viam-labs:nav-stack:nav-camera",
      "attributes": {
        "navigation": "nav"
      }
    }
  ],
  "services": [
    {
      "name": "slam",
      "api": "rdk:service:slam",
      "model": "viam-labs:nav-stack:slam",
      "attributes": {
        "base": "rover",
        "movement_sensor": "odometry",
        "lidar": "lidar",
        "movement_sensor_yaw_deg": 0,
        "mode": "mapping",
        "maps_dir": "/tmp/nav-maps",
        "active_map": "rover-pen"
      }
    },
    {
      "name": "nav",
      "api": "rdk:service:navigation",
      "model": "viam-labs:nav-stack:navigation",
      "attributes": {
        "slam_service": "slam",
        "base": "rover"
      }
    }
  ]
}
