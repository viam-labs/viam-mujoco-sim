{
  "module_id": "viam-labs:mujoco-sim",
  "visibility": "public",
  "url": "https://github.com/viam-labs/viam-mujoco-sim",
  "description": "Control and simulate robots in MuJoCo through Viam",
  "markdown_link": "README.md",
  "models": [
    {
      "model": "viam-labs:mujoco-sim:world",
      "api": "rdk:component:generic",
      "short_description": "Owns the MuJoCo scene, props and step loop",
      "markdown_link": "README.md#model-viam-labsmujoco-simworld"
    },
    {
      "model": "viam-labs:mujoco-sim:arm",
      "api": "rdk:component:arm",
      "short_description": "A simulated arm: UFactory Lite6, UR5e, or your own MJCF or URDF",
      "markdown_link": "README.md#model-viam-labsmujoco-simarm"
    },
    {
      "model": "viam-labs:mujoco-sim:gantry",
      "api": "rdk:component:gantry",
      "short_description": "An XYZ Cartesian gantry, generated from its travel, that the motion service plans like an arm",
      "markdown_link": "README.md#model-viam-labsmujoco-simgantry"
    },
    {
      "model": "viam-labs:mujoco-sim:gripper",
      "api": "rdk:component:gripper",
      "short_description": "A gripper on a mujoco-sim arm or gantry: the Lite6's, a Robotiq 2F-85 or ePick, or your own MJCF or URDF",
      "markdown_link": "README.md#model-viam-labsmujoco-simgripper"
    },
    {
      "model": "viam-labs:mujoco-sim:camera",
      "api": "rdk:component:camera",
      "short_description": "An RGB-D camera on the world or an arm's end effector",
      "markdown_link": "README.md#model-viam-labsmujoco-simcamera"
    },
    {
      "model": "viam-labs:mujoco-sim:base",
      "api": "rdk:component:base",
      "short_description": "A Viam Rover, a Clearpath Husky, or your own MJCF or URDF base",
      "markdown_link": "README.md#model-viam-labsmujoco-simbase"
    },
    {
      "model": "viam-labs:mujoco-sim:lidar",
      "api": "rdk:component:camera",
      "short_description": "A 2D or 3D LIDAR that serves point clouds",
      "markdown_link": "README.md#model-viam-labsmujoco-simlidar"
    },
    {
      "model": "viam-labs:mujoco-sim:imu",
      "api": "rdk:component:movement_sensor",
      "short_description": "An IMU: orientation, angular velocity and acceleration, with optional noise",
      "markdown_link": "README.md#model-viam-labsmujoco-simimu"
    },
    {
      "model": "viam-labs:mujoco-sim:force_torque",
      "api": "rdk:component:sensor",
      "short_description": "A wrist force-torque sensor at an arm's flange, with optional noise",
      "markdown_link": "README.md#model-viam-labsmujoco-simforce_torque"
    },
    {
      "model": "viam-labs:mujoco-sim:movement_sensor",
      "api": "rdk:component:movement_sensor",
      "short_description": "Wheel odometry for a mujoco-sim base, with optional drift",
      "markdown_link": "README.md#model-viam-labsmujoco-simmovement_sensor"
    },
    {
      "model": "viam-labs:mujoco-sim:obstacle",
      "api": "rdk:component:generic",
      "short_description": "Fixed geometry (box, sphere, capsule or mesh) shared by MuJoCo and the motion planner",
      "markdown_link": "README.md#model-viam-labsmujoco-simobstacle"
    },
    {
      "model": "viam-labs:mujoco-sim:robot",
      "api": "rdk:component:generic",
      "short_description": "A robot file with several limbs (ALOHA, a torso with arms), each limb a mujoco-sim arm",
      "markdown_link": "README.md#model-viam-labsmujoco-simrobot"
    },
    {
      "model": "viam-labs:mujoco-sim:scene",
      "api": "rdk:component:generic",
      "short_description": "An MJCF scene file placed by its frame: simulated, planned against, its free bodies movable as props",
      "markdown_link": "README.md#model-viam-labsmujoco-simscene"
    },
    {
      "model": "viam-labs:mujoco-sim:world_state",
      "api": "rdk:service:world_state_store",
      "short_description": "Streams movable props and parcels to the 3D scene viewer",
      "markdown_link": "README.md#model-viam-labsmujoco-simworld_state"
    },
    {
      "model": "viam-labs:mujoco-sim:conveyor",
      "api": "rdk:component:motor",
      "short_description": "A belt conveyor that carries parcels by friction",
      "markdown_link": "README.md#model-viam-labsmujoco-simconveyor"
    },
    {
      "model": "viam-labs:mujoco-sim:spawner",
      "api": "rdk:component:sensor",
      "short_description": "Feeds box parcels of random classes onto a conveyor; box-detect compatible",
      "markdown_link": "README.md#model-viam-labsmujoco-simspawner"
    },
    {
      "model": "viam-labs:mujoco-sim:photo_eye",
      "api": "rdk:component:sensor",
      "short_description": "A through-beam photo-eye that counts what passes",
      "markdown_link": "README.md#model-viam-labsmujoco-simphoto_eye"
    },
    {
      "model": "viam-labs:mujoco-sim:scale",
      "api": "rdk:component:sensor",
      "short_description": "A platform scale",
      "markdown_link": "README.md#model-viam-labsmujoco-simscale"
    }
  ],
  "entrypoint": "run.sh",
  "first_run": "first_run.sh",
  "build": {
    "build": "make module.tar.gz",
    "path": "module.tar.gz",
    "arch": [
      "linux/amd64",
      "darwin/arm64"
    ]
  }
}
