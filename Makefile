module.tar.gz: run.sh first_run.sh env.sh pyproject.toml uv.lock meta.json .python-version $(shell find src assets -type f -not -name '*.pyc')
	tar czf $@ --exclude='__pycache__' $^

# The entrypoint (run.sh) is generated by the build on purpose: viam's cloud
# reload treats a module whose entrypoint already exists in the repo as
# "pre-built" and skips packaging.
run.sh: run.nodetect.sh
	cp run.nodetect.sh run.sh

test:
	uv run python -m pytest

lint:
	uv run ruff check .

clean:
	rm -rf module.tar.gz run.sh

.PHONY: test lint clean
