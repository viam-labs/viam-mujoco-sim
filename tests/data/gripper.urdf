<?xml version="1.0"?>
<!-- A two-finger gripper: the right finger mimics the left, so the left
     finger's joint is the one the module drives. Fingers point along the
     palm's +z and close toward each other. -->
<robot name="pinch">
  <link name="palm">
    <inertial><mass value="0.3"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0 0 0.01"/><geometry><box size="0.1 0.03 0.02"/></geometry></collision>
  </link>
  <link name="left_finger">
    <inertial><origin xyz="0 0 0.03"/><mass value="0.05"/>
      <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0 0 0.03"/><geometry><box size="0.01 0.02 0.04"/></geometry></collision>
  </link>
  <link name="right_finger">
    <inertial><origin xyz="0 0 0.03"/><mass value="0.05"/>
      <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0 0 0.03"/><geometry><box size="0.01 0.02 0.04"/></geometry></collision>
  </link>
  <joint name="left_joint" type="prismatic">
    <parent link="palm"/><child link="left_finger"/><origin xyz="-0.04 0 0.02"/><axis xyz="1 0 0"/>
    <limit lower="0" upper="0.034" effort="20" velocity="0.1"/>
  </joint>
  <joint name="right_joint" type="prismatic">
    <parent link="palm"/><child link="right_finger"/><origin xyz="0.04 0 0.02"/><axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.034" effort="20" velocity="0.1"/>
    <mimic joint="left_joint" multiplier="1" offset="0"/>
  </joint>
</robot>
