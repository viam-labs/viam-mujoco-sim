<!-- A small workbench for viam-labs:mujoco-sim:scene, in meters, world origin
     at the Lite6's base: a checker floor (it replaces the world's), a low
     platform with two free blocks the Lite6 can pick, a wall behind the arm with
     a wedge brace (a mesh, planned as its hull) and a hinged flap. -->
<mujoco model="workbench">
  <asset>
    <texture name="checker" type="2d" builtin="checker" rgb1="0.52 0.52 0.5" rgb2="0.47 0.47 0.45"
             width="256" height="256"/>
    <material name="checker" texture="checker" texrepeat="8 8" texuniform="true"/>
    <material name="wood" rgba="0.6 0.45 0.3 1"/>
    <material name="wall" rgba="0.75 0.75 0.78 1"/>
    <mesh name="brace" vertex="0 0 0  0.12 0 0  0 0 0.2  0 0.03 0  0.12 0.03 0  0 0.03 0.2"/>
  </asset>
  <worldbody>
    <light name="bench_light" pos="0.3 0 1.5" dir="0 0 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="checker"/>
    <body name="platform" pos="0.25 0.15 0.025">
      <geom name="platform" type="box" size="0.1 0.08 0.025" material="wood"/>
    </body>
    <body name="wall" pos="-0.3 0 0.15">
      <geom name="wall" type="box" size="0.015 0.25 0.15" material="wall"/>
      <geom name="brace" type="mesh" mesh="brace" pos="0.015 0.1 -0.15" material="wall"/>
      <body name="flap" pos="0.02 -0.1 0.1">
        <joint name="flap_hinge" type="hinge" axis="0 1 0" range="-90 0" damping="0.05"/>
        <geom name="flap" type="box" size="0.004 0.06 0.04" pos="0 0 -0.04" material="wood"/>
      </body>
    </body>
    <body name="block_a" pos="0.22 0.15 0.06566">
      <freejoint/>
      <geom type="box" size="0.01565 0.01565 0.01565" mass="0.03" friction="2 0.005 0.0001" rgba="0.85 0.2 0.15 1"/>
    </body>
    <body name="block_b" pos="0.29 0.15 0.06566">
      <freejoint/>
      <geom type="box" size="0.01565 0.01565 0.01565" mass="0.03" friction="2 0.005 0.0001" rgba="0.2 0.45 0.85 1"/>
    </body>
  </worldbody>
</mujoco>
